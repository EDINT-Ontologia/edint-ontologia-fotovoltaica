# FOT12: ¿Dispone el elemento de infraestructura/edificio de una o varias instalaciones fotovoltaicas asociadas?

PREFIX rdf:      <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX edintfot: <https://edint.es/def/fotovoltaica#>
PREFIX edintinf: <https://edint.es/def/infraestructura#>

SELECT DISTINCT ?infrastructure
WHERE {
  ?infrastructure a edintinf:InfrastructureElement ;
                  edintfot:hasPhotovoltaicSystem ?pvSystem .
  ?pvSystem a edintfot:PhotovoltaicSystem .
}
ORDER BY ?infrastructure